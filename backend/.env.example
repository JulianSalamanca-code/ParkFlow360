# ============================================================================
# Variables de entorno del backend ParkFlow360
# Copia este archivo como .env (o configúralas en la plataforma de despliegue)
# y completa los valores. NO subas el .env real al repositorio.
# ============================================================================

# --- Base de datos (PostgreSQL / Supabase) ---
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# --- JWT ---
JWT_SECRET=clave-secreta-jwt-muy-segura-y-larga-para-parkflow360
JWT_EXPIRATION=86400000

# Servidor
# En Railway/Render el puerto se asigna automaticamente via PORT
# PORT=8080

# CORS: dominios del frontend separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://heartfelt-starlight-83718b.netlify.app

# Google OAuth (en producción, el callback es una ruta del frontend)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH2_REDIRECT_URI=https://parkflow360.onrender.com/api/auth/google/callback

# JPA
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
# --- CORS y frontend ---
CORS_ALLOWED_ORIGINS=http://localhost:4200
APP_FRONTEND_URL=http://localhost:4200

# --- Recuperación de contraseña por correo ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=ParkFlow360 <no-reply@parkflow360.com>
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true

# --- Login con Google (Google Identity Services) ---
# Client ID de OAuth 2.0 creado en https://console.cloud.google.com
GOOGLE_CLIENT_ID=

# --- Pago en línea con Wompi ---
# Credenciales del panel de Wompi (usa el entorno de pruebas/sandbox primero)
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
WOMPI_API_URL=https://sandbox.wompi.co/v1
WOMPI_CURRENCY=COP

# --- Servidor ---
PORT=8080
