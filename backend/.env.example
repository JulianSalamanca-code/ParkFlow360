# ============================================================
# ParkFlow360 Backend - Variables de entorno
# Copia este archivo a .env y completa los valores.
# NO subas el archivo .env al repositorio.
# ============================================================

# Base de datos (Supabase)
DB_URL=jdbc:postgresql://aws-0-us-west-2.pooler.supabase.com:6543/postgres?prepareThreshold=0
DB_USERNAME=postgres.pmijcynowbvxvqrratst
DB_PASSWORD=tu-password-de-supabase

# Alternativa: usar SUPABASE_PASSWORD en lugar de DB_PASSWORD
# SUPABASE_PASSWORD=tu-password-de-supabase

# JWT
JWT_SECRET=una-clave-secreta-muy-larga-y-segura
JWT_EXPIRATION=86400000

# Servidor
# En Railway/Render el puerto se asigna automaticamente via PORT
# PORT=8080

# CORS: dominios del frontend separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://heartfelt-starlight-83718b.netlify.app

# JPA
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
