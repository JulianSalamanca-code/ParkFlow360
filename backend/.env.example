# ============================================================================
# Variables de entorno del backend ParkFlow360
# Copia este archivo como .env (o configúralas en la plataforma de despliegue)
# y completa los valores. NO subas el .env real al repositorio.
# ============================================================================

# --- Base de datos (PostgreSQL / Supabase) ---
DB_URL=jdbc:postgresql://localhost:5432/parkflow360
DB_USERNAME=parkflow360
DB_PASSWORD=parkflow360

# --- JWT ---
JWT_SECRET=clave-secreta-jwt-muy-segura-y-larga-para-parkflow360
JWT_EXPIRATION=86400000

# --- CORS y frontend ---
CORS_ALLOWED_ORIGINS=http://localhost:4200
APP_FRONTEND_URL=http://localhost:4200

# --- Login con Google (Google Identity Services) ---
# Client ID de OAuth 2.0 creado en https://console.cloud.google.com
GOOGLE_CLIENT_ID=

# --- Pago en línea con Wompi ---
# Credenciales del panel de Wompi (usa el entorno de pruebas/sandbox primero)
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
WOMPI_API_URL=https://sandbox.wompi.co/v1
WOMPI_CURRENCY=COP

# --- Servidor ---
PORT=8080
